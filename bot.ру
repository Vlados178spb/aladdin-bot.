import logging
import requests
from datetime import datetime
from zoneinfo import ZoneInfo
from telegram import Update
from telegram.ext import ApplicationBuilder, CommandHandler, ContextTypes

# --- НАСТРОЙКИ ---
BOT_TOKEN = "8694698903:AAHK51pTIQo4TFcBBF1RbL4Kh5OZRiLGTiM"
ODDS_API_KEY = "2be3c040e725dabfe695ae282049a8b0"
# Спорт: футбол. Регион: 'eu' (европейские букмекеры). Рынок: 'h2h' (победитель матча)
API_URL = f"https://api.the-odds-api.com/v4/sports/soccer_epl/odds/?apiKey={ODDS_API_KEY}&regions=eu&markets=h2h"

logging.basicConfig(format="%(asctime)s - %(name)s - %(levelname)s - %(message)s", level=logging.INFO)

# --- ПОЛУЧЕНИЕ И ФИЛЬТРАЦИЯ ДАННЫХ ---
def get_filtered_matches():
    try:
        resp = requests.get(API_URL)
        resp.raise_for_status()
        data = resp.json()
        matches = []

        for event in data:
            # Извлекаем время матча
            commence_time = event.get("commence_time")
            if not commence_time:
                continue
            dt_utc = datetime.fromisoformat(commence_time.replace("Z", "+00:00"))
            dt_msk = dt_utc.astimezone(ZoneInfo("Europe/Moscow"))
            time_str = dt_msk.strftime("%H:%M")

            # Извлекаем коэффициенты для рынка h2h
            bookmakers = event.get("bookmakers", [])
            if not bookmakers:
                continue
            # Для простоты берём первого букмекера (обычно Pinnacle или Bet365)
            markets = bookmakers[0].get("markets", [])
            if not markets:
                continue
            outcomes = markets[0].get("outcomes", [])
            if len(outcomes) < 2:
                continue

            home_odd = away_odd = None
            for outcome in outcomes:
                if outcome["name"] == event["home_team"]:
                    home_odd = outcome["price"]
                elif outcome["name"] == event["away_team"]:
                    away_odd = outcome["price"]

            if home_odd is None or away_odd is None:
                continue

            # ФИЛЬТР: хозяева <= 3.6 И гости <= 2.1
            if home_odd <= 3.6 and away_odd <= 2.1:
                matches.append({
                    "home_team": event["home_team"],
                    "away_team": event["away_team"],
                    "home_odd": home_odd,
                    "away_odd": away_odd,
                    "time": dt_msk,
                    "time_str": time_str,
                    "sport_title": event.get("sport_title", "Football"),
                })

        # СОРТИРОВКА ПО ВРЕМЕНИ
        matches.sort(key=lambda x: x["time"])
        return matches

    except Exception as e:
        logging.error(f"Ошибка при получении матчей: {e}")
        return []

# --- КОМАНДА /start ---
async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    matches = get_filtered_matches()
    if not matches:
        await update.message.reply_text("😕 Подходящих матчей не найдено.")
        return

    # Отправляем каждый матч отдельным сообщением
    for m in matches:
        msg = (
            f"🇷🇺 {m['sport_title']}\n"
            f"🕰️ {m['time_str']} (МСК)\n"
            f"🏟️ {m['home_team']} ({m['home_odd']:.2f}) & {m['away_team']} ({m['away_odd']:.2f})"
        )
        await update.message.reply_text(msg)

    # Информация о лимитах API (полезно для бесплатного тарифа)
    await update.message.reply_text(
        "✅ Готово! Это все подходящие матчи.\n"
        "💡 Используйте /start для обновления."
    )

# --- ЗАПУСК БОТА ---
if __name__ == "__main__":
    app = ApplicationBuilder().token(BOT_TOKEN).build()
    app.add_handler(CommandHandler("start", start))
    print("🚀 Бот запущен...")
    app.run_polling()
